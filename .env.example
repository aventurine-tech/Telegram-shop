# .env.example
# SECURITY WARNING: Never commit real credentials to version control!
# Copy this file to .env and fill with actual values

# === TELEGRAM CONFIGURATION ===
# Get from @BotFather
TOKEN=your_bot_token_here
# Your Telegram user ID (get from @userinfobot)
OWNER_ID=123456789

# === ORDERS & PAYMENTS ===
# The shop sells physical goods and accepts exactly two payment methods:
#   * MIA     - the customer pays by MIA instant transfer; staff confirm the transfer in the bot
#   * COD     - cash on delivery / cash on pickup
# Currency shown in prices (3-letter code: MDL, EUR, RON, ...)
PAY_CURRENCY=MDL

# --- MIA ---
# Where customers send the transfer. MIA is offered only if at least one of these is set.
MIA_RECIPIENT=
# Phone number linked to your MIA account (customers can pay to a number)
MIA_PHONE=
# IBAN, shown as an alternative
MIA_IBAN=
# Minutes a customer has to pay an MIA order. Unpaid orders are cancelled and their stock released.
MIA_PAY_TIMEOUT_MIN=120

# --- Cash on delivery / pickup (1 = enabled, 0 = disabled) ---
COD_ENABLED=1

# --- Fulfilment (1 = enabled, 0 = disabled) ---
DELIVERY_ENABLED=1
PICKUP_ENABLED=1
# Shown to customers who choose pickup
PICKUP_ADDRESS=
# Optional note shown to customers who choose delivery (areas, cost, timing)
DELIVERY_INFO=

# Optional: a staff chat/group ID that also receives new-order alerts
# (staff with the order-management permission always get them in private chat)
ORDERS_CHAT_ID=

# Store balance + referrals (balance is credited by admins, promo codes and referral commissions)
# Referral commission % paid when a referred customer's order is completed (0-99, 0 to disable)
REFERRAL_PERCENT=0
# Allowed range for an admin's manual balance top-up / deduction
MIN_AMOUNT=1
MAX_AMOUNT=100000

# === LINKS & UI CONFIGURATION ===
# Telegram channel for notifications (optional)
# Format: @channelname or https://t.me/channelname
CHANNEL_URL=

# Telegram channel ID
# Get from: @get_id_bot
CHANNEL_ID=

# Support user ID (optional)
HELPER_ID=

# Bot rules text (optional)
RULES="1. Be respectful\n2. No spam\n3. Follow Telegram ToS"

# === LOCALIZATION & LOGGING ===
# Bot language (ru or en)
BOT_LOCALE=en

# Log files paths
BOT_LOGFILE=logs/bot.log
BOT_AUDITFILE=logs/audit.log

# Logging configuration (1 to enable, 0 to disable)
LOG_TO_STDOUT=1
LOG_TO_FILE=1
DEBUG=0

# Enable/disable the review system (1 = enabled, 0 = disabled)
REVIEWS_ENABLED=1

# === REDIS CONFIGURATION ===
# Set to 0 to disable Redis entirely (bot will use in-memory storage)
# When disabled, FSM states are lost on restart and caching is disabled
REDIS_ENABLED=1
# For FSM storage and caching
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Redis password. Must stay non-empty when using the bundled Docker Redis service
# (an empty value crashes the redis container on startup). Change it in production.
REDIS_PASSWORD=changeme_redis_pass

# === DATABASE CONFIGURATION ===
# PostgreSQL settings
POSTGRES_DB=telegram_shop
POSTGRES_USER=shop_user
# SECURITY: Use strong password!
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=change_me_to_strong_password
# POSTGRES_HOST is automatically set to 'db' in Docker environment
POSTGRES_HOST=localhost
DB_PORT=5432
# Connection pool. Raise these if a busy shop starts waiting on connections.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# === WEB ADMIN PANEL ===
ADMIN_HOST=localhost
ADMIN_PORT=9090
ADMIN_USERNAME=admin
# SECURITY: the bot REFUSES TO START with these two left at their defaults when the
# panel is reachable (ADMIN_HOST is not loopback, or WEBHOOK_ENABLED=1). SECRET_KEY
# signs the admin session cookie — a known key means anyone can forge a login.
ADMIN_PASSWORD=admin
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
# Mark the session cookie Secure (HTTPS only). auto = on unless the panel is
# loopback-only. Force with 1/0 when a reverse proxy terminates TLS.
ADMIN_COOKIE_SECURE=auto

# === WEBHOOK MODE (optional) ===
# Set WEBHOOK_ENABLED=1 to use webhook instead of polling.
# The webhook is served by its own app on its own port, so publishing it to the
# internet does NOT publish the admin panel. Point your reverse proxy at
# WEBHOOK_HOST:WEBHOOK_PORT only.
WEBHOOK_ENABLED=0
# Public URL for webhook (e.g., https://yourdomain.com)
WEBHOOK_URL=
# Path for webhook endpoint
WEBHOOK_PATH=/webhook
# Secret token for webhook verification
WEBHOOK_SECRET=
# Bind address/port for the webhook listener (behind your reverse proxy)
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080

# === AUTO-CLEANUP ===
# Days to keep audit log entries (0 or negative disables the sweep entirely)
AUDIT_RETENTION_DAYS=90

# === DOCKER PERMISSIONS (Linux only) ===
# Set these to match your host user's UID/GID on Linux
# Run 'id' command on your host to find your UID/GID
# Default: 1000 (common for first non-root user on Linux)
# Only needed if you get permission errors on logs/ or data/ directories
# PUID=1000
# PGID=1000